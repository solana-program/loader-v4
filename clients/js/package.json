{
    "name": "@solana-program/loader-v4",
    "version": "0.0.0",
    "description": "JavaScript client for the Solana Loader V4 program",
    "homepage": "https://github.com/solana-program/loader-v4#readme",
    "bugs": {
        "url": "https://github.com/solana-program/loader-v4/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/solana-program/loader-v4.git"
    },
    "files": [
        "./dist/src",
        "./dist/types"
    ],
    "type": "commonjs",
    "sideEffects": false,
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.mjs",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/src/index.mjs",
            "require": "./dist/src/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "rimraf dist && tsup && tsc -p ./tsconfig.declarations.json",
        "build:docs": "typedoc",
        "dev": "vitest",
        "test": "vitest run",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt --check",
        "format:fix": "oxfmt",
        "prepublishOnly": "pnpm build"
    },
    "devDependencies": {
        "@solana-config/oxc": "^0.1.1",
        "@solana/kit": "^6.4.0",
        "@solana/kit-plugin-rpc": "^0.11.0",
        "@solana/kit-plugin-signer": "^0.10.0",
        "@types/node": "^20",
        "oxfmt": "^0.55.0",
        "oxlint": "^1.70.0",
        "oxlint-tsgolint": "^0.23.0",
        "rimraf": "^5.0.5",
        "tsup": "^8.0.2",
        "typedoc": "^0.25.12",
        "typedoc-plugin-missing-exports": "^2.2.0",
        "typescript": "^5.4.2",
        "vitest": "^4.0.15"
    },
    "peerDependencies": {
        "@solana/kit": "^6.4.0"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@9.1.0"
}
